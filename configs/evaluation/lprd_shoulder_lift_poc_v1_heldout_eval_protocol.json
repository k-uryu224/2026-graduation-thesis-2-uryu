{
  "experiment_id": "lprd_shoulder_lift_poc_v1_heldout_minus5",

  "purpose": "Test whether pi0.5-derived local action-response supervision improves SmolVLA at the held-out shoulder_lift -5 degree perturbation.",

  "models": {
    "frozen_base": "outputs/train/smolvla_baseline_dense_x_v2/checkpoints/030000/pretrained_model",
    "no_response": "outputs/train/lprd_shoulder_lift_poc_v1/no_response/checkpoints/000500/pretrained_model",
    "pointwise_kd": "outputs/train/lprd_shoulder_lift_poc_v1/pointwise_kd/checkpoints/000500/pretrained_model",
    "response_target": "outputs/train/lprd_shoulder_lift_poc_v1/response_target/checkpoints/000500/pretrained_model"
  },

  "evaluation": {
    "object_x_m": 0.240,
    "shoulder_lift_offset_deg": -5.0,
    "variation_ids": [
      "v05", "v06", "v07", "v08", "v09",
      "v10", "v11", "v12", "v13", "v14",
      "v15", "v16", "v17", "v18", "v19"
    ],
    "noise_seeds": [
      20261015,
      20261016,
      20261017
    ],
    "n_action_steps": 10,
    "frames": 210,
    "trials_per_policy": 45
  },

  "training_firewall": {
    "training_offsets_deg": [-6.0, -4.0],
    "heldout_offset_deg": -5.0,
    "heldout_variations_used_for_training": false,
    "heldout_noise_seeds_used_for_training": false
  },

  "analysis": {
    "primary_endpoint": "closed-loop grasp success rate at held-out -5 degree shoulder_lift perturbation",
    "matched_unit": "variation_id x noise_seed",
    "confidence_interval": "Wilson 95 percent",
    "primary_comparison": {
      "policies": ["response_target", "frozen_base"],
      "test": "exact two-sided McNemar",
      "alpha": 0.05
    },
    "secondary_comparisons": [
      {
        "policies": ["response_target", "no_response"],
        "test": "exact two-sided McNemar"
      },
      {
        "policies": ["response_target", "pointwise_kd"],
        "test": "exact two-sided McNemar"
      }
    ],
    "checkpoint_selection_after_evaluation": false
  }
}
