{
  "implementation_id": "lprd_shoulder_lift_poc_v1_teacher_response",
  "source_protocol_tag": "lprd-shoulder-lift-poc-v1-protocol",

  "dataset_root": "results/lerobot_datasets/so101_pick_object_train_dense_x_100eps",
  "manifest": "experiment_manifest.csv",

  "task_condition": {
    "instruction": "Pick up the object.",
    "object_x_m": 0.240,
    "object_y_m": 0.0,
    "object_z_m": 0.065
  },

  "reference_demo": {
    "source": "frozen dense-x v2 Script+IK dataset",
    "variation_ids": ["v00", "v01", "v02", "v03", "v04"],
    "action_frame_start_inclusive": 0,
    "action_frame_stop_exclusive": 50,
    "expected_episode_indices": {
      "v00": 40,
      "v01": 41,
      "v02": 42,
      "v03": 43,
      "v04": 44
    }
  },

  "teacher_observations": {
    "reference_shoulder_lift_offset_deg": 0.0,
    "perturbed_shoulder_lift_offsets_deg": [-6.0, -4.0],
    "only_initial_shoulder_lift_is_perturbed": true
  },

  "teacher_action": {
    "chunk_size": 50,
    "postprocessed_action_dim": 6,
    "space": "physical postprocessed action before actuator clipping",
    "same_noise_tensor_within_reference_perturbation_pair": true,
    "same_noise_seed_set_across_variations": true
  },

  "response_target": {
    "formula": "A_demo(reference) + mean_z[A_teacher(perturbed,z) - A_teacher(reference,z)]",
    "clip_synthesized_target_to_actuator_range": true,
    "record_preclip_target": true,
    "record_clip_statistics": true
  },

  "held_out_from_teacher_response_extraction": {
    "shoulder_lift_offset_deg": -5.0,
    "evaluation_variation_ids": [
      "v05", "v06", "v07", "v08", "v09",
      "v10", "v11", "v12", "v13", "v14",
      "v15", "v16", "v17", "v18", "v19"
    ]
  }
}
